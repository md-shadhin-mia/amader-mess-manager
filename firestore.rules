rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // Valid only for the atomic first-login batch that creates this document.
    function isFirstAdmin() {
      return isSignedIn()
        && getAfter(/databases/$(database)/documents/settings/app).data.firstAdminUid == request.auth.uid;
    }

    // The bootstrap admin cannot be demoted or deleted, so at least one admin remains.
    function isPrimaryAdmin(userId) {
      return exists(/databases/$(database)/documents/settings/app)
        && get(/databases/$(database)/documents/settings/app).data.firstAdminUid == userId;
    }

    match /settings/app {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/settings/app)
        && request.resource.data.firstAdminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (request.resource.data.role == 'member'
          || (request.resource.data.role == 'manager' && isFirstAdmin()));
      // Members may edit their name, phone number and push token, but never their role.
      // An admin can manage other roles but cannot demote the bootstrap admin.
      allow update: if (isManager()
          && (!isPrimaryAdmin(userId) || request.resource.data.role == 'manager'))
        || (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'fcm_token', 'fcm_token_updated_at']))
        // Allows the first already-existing user to become the bootstrap admin in one batch.
        || (isSignedIn()
          && request.auth.uid == userId
          && isFirstAdmin()
          && request.resource.data.role == 'manager'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if isManager() && !isPrimaryAdmin(userId);
    }

    match /months/{monthId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /daily_meals/{mealId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /bazar_fund/{fundId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /bazar_expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /bazar_schedule/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Written only by the push-notification Cloudflare Worker (service account, bypasses rules).
    match /notification_logs/{logId} {
      allow read: if isManager();
      allow write: if false;
    }
  }
}
