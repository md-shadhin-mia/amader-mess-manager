rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // Check if the user is a manager
    function isManager() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Users can read all users (to see who is in the mess)
      allow read: if isSignedIn();
      // Allow users to create their own basic profile, managers can create anyone
      allow create: if isManager() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isManager() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isManager();
    }

    match /months/{monthId} {
      allow read: if isSignedIn();
      // Only manager can create/update months
      allow write: if isManager();
    }

    match /daily_meals/{mealId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /bazar_fund/{fundId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /bazar_expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /bazar_schedule/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }
  }
}
